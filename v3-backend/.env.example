# Configuracion local para v3-backend (NestJS 11 + Fastify 5)
NODE_ENV=development
PORT=3100
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:7200

# Conexion a PostgreSQL 17 Unificado (Docker en v3-infra, puerto 5434)
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=asaie_admin
DB_PASSWORD=asaie_local_secret_2026
DB_NAME=asaie_v3_unified

# Conexion a Redis 7.4 para Colas BullMQ y Cache (Docker en v3-infra, puerto 6384)
REDIS_HOST=127.0.0.1
REDIS_PORT=6384

# Autenticacion JWT Multi-Tenant
JWT_SECRET=asaie-v3-super-secret-development-key-change-in-production
JWT_EXPIRES_IN=8h

# Binario de JasperStarter / Motor JasperReports
JASPER_STARTER_BIN=jasperstarter
