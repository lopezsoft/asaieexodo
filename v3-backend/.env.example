# Configuracion local para v3-backend (NestJS 11 + Fastify 5)
NODE_ENV=development
PORT=3100
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:7200
APP_NAME="ASAIE EXODO"
APP_KEY=base64:YOUR_APP_KEY_HERE
SITE_URL=https://asaie.co

# Conexion a PostgreSQL 17 Unificado (Docker en v3-infra, puerto 5434)
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=asaie_admin
DB_PASSWORD=asaie_local_secret_2026
DB_NAME=asaie_v3_unified

# Conexion a MariaDB/MySQL Legacy Local para Migracion ETL (myschoolsadmin_exodo + asaie_exodo)
LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3307
LEGACY_MYSQL_USER=root
LEGACY_MYSQL_PASSWORD=
LEGACY_BRIDGE_DB=myschoolsadmin_exodo
LEGACY_SCHOOL_DB=asaie_exodo

# Conexion a Redis 7.4 para Colas BullMQ y Cache (Docker en v3-infra, puerto 6384)
REDIS_HOST=127.0.0.1
REDIS_PORT=6384
REDIS_PASSWORD=

# Autenticacion JWT Multi-Tenant
JWT_SECRET=asaie-v3-super-secret-development-key-2026
JWT_EXPIRES_IN=8h

# Correo SMTP (AWS SES)
MAIL_DRIVER=smtp
MAIL_HOST=email-smtp.us-west-2.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_SMTP_USERNAME
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@asaie.co
MAIL_FROM_NAME="ASAIE EXODO"

# Almacenamiento Cloud AWS S3 y Colas SQS
FILESYSTEM_DRIVER=s3
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-west-2
AWS_BUCKET=asaie-app-storage
AWS_MAIN_PATH=test
AWS_URL=https://asaie-app-storage.s3.us-west-2.amazonaws.com
SQS_PREFIX=https://sqs.us-west-2.amazonaws.com/YOUR_ACCOUNT_ID
SQS_QUEUE=AsaieExodo

# Binario de JasperStarter / Motor JasperReports
JASPER_STARTER_BIN=jasperstarter
