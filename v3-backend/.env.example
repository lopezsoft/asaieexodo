# Configuracion local para v3-backend (NestJS 11 + Fastify 5)
# Entorno de ejecucion (development | test | staging | production)
NODE_ENV=development
# Puerto HTTP del servidor Fastify
PORT=3100
# Interfaz de escucha del servidor HTTP
HOST=0.0.0.0
# Origenes CORS permitidos separados por coma (en produccion nunca usar *)
CORS_ORIGIN=http://localhost:7200
# URL publica del portal Angular V3 para enlaces de correo (confirmacion y recuperacion)
FRONTEND_URL=http://localhost:7200
# Habilita la interfaz OpenAPI/Swagger (en produccion por defecto false)
SWAGGER_ENABLED=true
# Nombre institucional de la plataforma
APP_NAME="ASAIE EXODO"
# Llave simetrica heredada de compatibilidad
APP_KEY=base64:YOUR_APP_KEY_HERE
# URL institucional principal
SITE_URL=https://asaie.co

# Conexion a PostgreSQL 17 Unificado (Docker en v3-infra, puerto 5434)
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=asaie_admin
DB_PASSWORD=asaie_local_secret_2026
DB_NAME=asaie_v3_unified
# Maximo de conexiones simultaneas en el pool pg
DB_POOL_MAX=25
# Activa cifrado TLS contra PostgreSQL (true en AWS RDS/Aurora produccion)
DB_SSL=false

# Conexion a MariaDB/MySQL Legacy Local para Migracion ETL (mig-schools-admin + mig-schools-*)
LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3307
LEGACY_MYSQL_USER=root
LEGACY_MYSQL_PASSWORD=
# Ruta opcional al binario CLI mysql/mariadb (vacio = autodeteccion WAMP / PATH del sistema)
LEGACY_MYSQL_BIN=
# Nombre de la base de datos puente maestra en MariaDB/MySQL legacy
LEGACY_BRIDGE_DB=mig-schools-admin
# Nombre de la base de datos de la institucion educativa a migrar
LEGACY_SCHOOL_DB=mig-schools-franjocal
# Filtro opcional de años a migrar separados por coma (vacio o ALL = migrar toda la historia completa)
LEGACY_MIGRATION_YEARS=ALL

# Conexion a Redis 7.4 para Colas BullMQ, Rate Limiting y Cache (Docker en v3-infra, puerto 6384)
REDIS_HOST=127.0.0.1
REDIS_PORT=6384
# Contrasena de autenticacion Redis (obligatoria con --requirepass y en produccion)
REDIS_PASSWORD=asaie_redis_local_secret_2026
# Activa conexion TLS hacia Redis (true en ElastiCache/Upstash produccion)
REDIS_TLS=false

# Autenticacion JWT Multi-Tenant (en produccion minimo 32 caracteres aleatorios)
JWT_SECRET=asaie-v3-super-secret-development-key-2026
# Duracion de sesion JWT de acceso (ej. 8h, 12h)
JWT_EXPIRES_IN=8h

# Correo SMTP (AWS SES / Nodemailer)
MAIL_DRIVER=smtp
MAIL_HOST=email-smtp.us-west-2.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_SMTP_USERNAME
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
# Cifrado de transporte SMTP (tls para STARTTLS 587 | ssl para 465)
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@asaie.co
MAIL_FROM_NAME="ASAIE EXODO"

# Almacenamiento Cloud AWS S3 y Colas SQS
FILESYSTEM_DRIVER=s3
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-west-2
AWS_BUCKET=asaie-app-storage
# Prefijo raiz de entorno dentro del bucket S3 (ej. test | staging | prod)
AWS_MAIN_PATH=test
AWS_URL=https://asaie-app-storage.s3.us-west-2.amazonaws.com
# Endpoint S3 personalizado opcional para MinIO/LocalStack en desarrollo
AWS_ENDPOINT=
# Usa estilo path-style para S3 compatible local (true solo con MinIO/LocalStack)
AWS_USE_PATH_STYLE_ENDPOINT=false
SQS_PREFIX=https://sqs.us-west-2.amazonaws.com/YOUR_ACCOUNT_ID
SQS_QUEUE=AsaieExodo

# Proveedor de Embeddings Semánticos Vectoriales para CRM Escolar (pgvector 768 dims)
# Valores posibles: fallback | external_http
EMBEDDING_PROVIDER=fallback
# URL del endpoint HTTP de embeddings externos (si EMBEDDING_PROVIDER=external_http)
EMBEDDING_API_URL=
# Clave API del proveedor externo de embeddings (opcional si se usa fallback)
EMBEDDING_API_KEY=
# Modelo de embeddings de 768 dimensiones (ej. text-embedding-004)
EMBEDDING_MODEL=text-embedding-004

# Motor de reportes institucionales (native = HTML->PDF via Gotenberg + ExcelJS | jasper = JasperStarter legacy)
REPORT_ENGINE=native
# URL del servicio Gotenberg 8 para renderizado HTML->PDF oficial con paginacion @page (Docker puerto 3010)
GOTENBERG_URL=http://127.0.0.1:3010
# Motor JasperReports y credenciales restringidas de lectura para reportes (solo si REPORT_ENGINE=jasper)
JASPER_STARTER_BIN=jasperstarter
# Usuario PostgreSQL dedicado de solo lectura para JasperReports (opcional; fallback a DB_USER en local)
JASPER_DB_USER=
# Contrasena del usuario de solo lectura para JasperReports
JASPER_DB_PASSWORD=

# Contrasena inicial del usuario maestro en CLI bootstrap-nine-schools (solo desarrollo/pruebas)
BOOTSTRAP_ADMIN_PASSWORD=Asaie2026*

# Dias de prueba inicial gratuita para nuevas Instituciones Educativas auto-registradas (rango 7-365)
SCHOOL_TRIAL_DAYS=30
