	<queryString>
		<![CDATA[SELECT a.inst_address, a.inst_origin, a.`year`, ap.msg, g.cod_grado, g.grado
FROM grados AS g
LEFT JOIN student_enrollment AS a  ON (a.id_grade = g.id AND a.id_student = $P{id_student}  )
LEFT JOIN acta_promocion AS ap ON ap.id_matric = a.id
WHERE g.id BETWEEN 4 AND 15 AND g.uso = 1]]>
	</queryString>
