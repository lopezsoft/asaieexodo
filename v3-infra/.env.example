# Configuracion local de contenedores para Base de Datos Unificada y Colas (Puertos dedicados sin colision)
# Puerto local expuesto en 127.0.0.1 para PostgreSQL 17 con pgvector 0.8.1
POSTGRES_PORT=5434
# Usuario administrador de inicializacion y migraciones DDL de PostgreSQL 17
POSTGRES_USER=asaie_admin
# Contrasena del usuario administrador de PostgreSQL 17 (cambiar en entornos remotos)
POSTGRES_PASSWORD=asaie_local_secret_2026
# Nombre de la base de datos unificada Multi-Tenant (Single-DB RLS)
POSTGRES_DB=asaie_v3_unified

# Puerto local expuesto en 127.0.0.1 para Redis 7.4 (BullMQ y rate limiting)
REDIS_PORT=6384
# Contrasena obligatoria de autenticacion para Redis 7.4 (--requirepass)
REDIS_PASSWORD=asaie_redis_local_secret_2026

# Puerto local expuesto en 127.0.0.1 para Gotenberg 8 (renderizado oficial HTML->PDF sin JVM/Jasper)
GOTENBERG_PORT=3010
